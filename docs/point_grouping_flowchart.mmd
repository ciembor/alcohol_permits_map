flowchart TB
  title["<b>Public dataset processing flow</b>"]

  sources["<b>1. Sources</b><br/>XLS/XLSX reports, BIP PDFs/CSVs,<br/>source manifest"]
  import["<b>2. Import</b><br/><code>research:import_sources</code><br/>licenses, operators, raw locations,<br/>streets and SIM population"]
  normalize["<b>3. Normalize</b><br/><code>research:normalize_locations</code><br/>street names, numbers, units,<br/>parcels and address corrections"]
  geocode["<b>4. Geocode</b><br/><code>research:geocode_open</code><br/>MSIP, GUS, ULDK, OSM/Nominatim<br/>plus manual review decisions"]
  grouping["<b>5. Group points</b><br/><code>research:rebuild_analysis</code><br/>coordinates, unit context and<br/>operator-name similarity"]
  aggregate["<b>6. Aggregate</b><br/>SIM assignment, city/district/SIM summaries,<br/>density and resident indicators"]
  release["<b>7. Release</b><br/><code>research:release_dataset</code><br/><code>research:prepare_zenodo_repository</code><br/>validated CSV/GeoJSON package"]

  curation[("<b>Curated snapshot</b><br/><code>db/curation/current.json</code><br/>address fixes, selected points,<br/>review outcomes")]
  validation[("<b>Validation gates</b><br/>IDs, relations, dates, coordinates,<br/>GeoJSON, restricted-response checks")]
  outputs[("<b>Outputs</b><br/>Zenodo package and public map layer<br/>licenses, locations, sales points,<br/>memberships, audits and aggregates")]

  title --> sources --> import --> normalize --> geocode --> grouping --> aggregate --> release --> outputs

  curation -.-> normalize
  curation -.-> geocode
  curation -.-> grouping
  validation -.-> release

  classDef header fill:#4f5f5b,stroke:#4f5f5b,stroke-width:1px,color:#ffffff;
  classDef main fill:#f7f7f3,stroke:#4f5f5b,stroke-width:1.2px,color:#202321;
  classDef side fill:#eef3f0,stroke:#6c7c77,stroke-width:1px,color:#202321,stroke-dasharray: 4 3;
  classDef output fill:#f2f0ea,stroke:#8a7d63,stroke-width:1.1px,color:#202321;

  class title header;
  class sources,import,normalize,geocode,grouping,aggregate,release main;
  class curation,validation side;
  class outputs output;
