%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial", "fontSize": "11px", "primaryColor": "#f7f7f3", "primaryBorderColor": "#4f5f5b", "primaryTextColor": "#202321", "lineColor": "#68736f", "tertiaryColor": "#eef3f0"}, "flowchart": {"curve": "basis", "nodeSpacing": 12, "rankSpacing": 14, "htmlLabels": true}}}%%
flowchart TB
  title["<b>Public dataset processing flow</b>"]

  xlsx[("<b>1a. Spreadsheet archive</b><br/>XLS/XLSX reports<br/>from the municipal office")]
  bip[("<b>1b. BIP publication archive</b><br/>official publication pages<br/>and downloadable PDFs")]
  crawler["<b>Crawler</b><br/>downloads PDFs<br/>and records source metadata"]
  pdfcsv[("<b>PDF/CSV archive</b><br/>PDF files and extracted CSV tables<br/>with extraction checks")]
  sources["<b>2. Source selection rule</b><br/>XLS/XLSX preferred where available;<br/>later reports use PDF-derived CSVs"]
  import["<b>3. Import and provenance</b><br/><code>research:import_sources</code><br/>licenses, operators, raw locations,<br/>streets and SIM population"]
  normalize["<b>4. Normalize</b><br/><code>research:normalize_locations</code><br/>street names, numbers, units,<br/>parcels and address corrections"]
  geocode["<b>5. Geocode</b><br/><code>research:geocode_open</code><br/>MSIP, GUS, ULDK, OSM/Nominatim<br/>plus manual review decisions"]
  grouping["<b>6. Group points</b><br/><code>research:rebuild_analysis</code><br/>coordinates, unit context and<br/>operator-name similarity"]
  aggregate["<b>7. Aggregate</b><br/>SIM assignment, city/district/SIM summaries,<br/>density and resident indicators"]
  release["<b>8. Release</b><br/><code>research:release_dataset</code><br/><code>research:prepare_zenodo_repository</code><br/>validated CSV/GeoJSON package"]

  curation[("<b>Curated snapshot</b><br/><code>db/curation/current.json</code><br/>address fixes, selected points,<br/>review outcomes")]
  validation["<b>Validation gates</b><br/>IDs, relations, dates, coordinates,<br/>GeoJSON, restricted-response checks"]
  outputs[("<b>Outputs</b><br/>Zenodo package and public map layer<br/>licenses, locations, points,<br/>memberships and aggregates")]

  title --> xlsx --> sources
  title --> bip --> crawler --> pdfcsv --> sources
  sources --> import --> normalize --> geocode --> grouping --> aggregate --> release --> outputs

  curation -.-> normalize
  curation -.-> geocode
  curation -.-> grouping
  validation -.-> release

  classDef header fill:#4f5f5b,stroke:#4f5f5b,stroke-width:1px,color:#ffffff;
  classDef main fill:#f7f7f3,stroke:#4f5f5b,stroke-width:1.2px,color:#202321;
  classDef data fill:#eef3f0,stroke:#4f5f5b,stroke-width:1.2px,color:#202321;
  classDef gate fill:#fff8e6,stroke:#8a7d63,stroke-width:1.2px,color:#202321;
  classDef side fill:#eef3f0,stroke:#6c7c77,stroke-width:1px,color:#202321,stroke-dasharray: 4 3;
  classDef output fill:#f2f0ea,stroke:#8a7d63,stroke-width:1.1px,color:#202321;

  class title header;
  class crawler,import,normalize,geocode,grouping,aggregate,release main;
  class xlsx,bip,pdfcsv data;
  class sources,validation gate;
  class curation side;
  class outputs output;
